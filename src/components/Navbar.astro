        <p class="text-sm cursor-default">francescogiannini.dev</p>
    </div>
    <!-- center, information links -->
    <!-- <div class="w-full h-full flex items-center text-xs">
        <ul class="flex gap-3">
            <a href="#" class="transition relative group">About</a>
            <a href="#" class="transition relative group">Projects</a>
            <a href="#" class="transition relative group">Contact</a>
        </ul>
    </div> -->
    <!-- right side, utility / burger menu? -->
    <div class="w-full h-full flex items-center justify-end">
        <span class="clock"><span id="clock-time"></span><span id="clock-label" class="hidden md:inline"> MY TIME</span></span>
    </div>
</div>



<style>
    .clock {
        font-size: 0.75rem;
        opacity: 0.4;
        cursor: default;
        user-select: none;
        letter-spacing: 0.05em;
    }

    .group::after {
      content: "";
      position: absolute;
      left: 50%;
      bottom: -5px; /* Adjust for spacing */
      width: 0%;
      height: 2px;
      background: rgba(96, 165, 250, 0.5);
      transition: width 0.3s ease, left 0.3s ease;
    }
  
    .group:hover::after {
      width: 120%;
      left: -10%;
    }

    /* this was a sort of 'underlight' effect, looked cooler in theory */
    /* .group::before {
        content: "";
        position: absolute;
        bottom: -5px;
        left: -10%;
        width: 120%;
